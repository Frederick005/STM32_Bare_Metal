// the USER LED for stm32c031. where is it? Ans: PA5
// Port = A
// PIN = 5

#define PREIPH_BASE          (0x40000000UL)

/* We need the AHB bus base location so that RCC can provide
 * clock to the GPIO ports
 */
#define AHB_BUS_OFFSET       (0x00020000UL)
#define AHB_BUS_BASE         (PREIPH_BASE + AHB_BUS_OFFSET)

/* The RCC base is needed now so that we can provide clock where
 * required
 */
#define RCC_OFFSET           (0x00001000UL)
#define AHB_RCC_BASE         (AHB_BUS_BASE + RCC_OFFSET)

/* The RCC register which for providing clock to GPIO port A
 */
#define RCC_GPIOA_OFFSET     (0x34UL)
#define AHB_RCC_GPIOA_R      (*(volatile unsigned int *))(AHB_RCC_BASE + RCC_GPIOA_OFFSET)

/* We need the IOPORT bus base location so that the GPIO ports
 * can be manipulated
 */
#define IOPORT_BUS_OFFSET    (0x10000000UL)
#define IOPORT_BUS_BASE      (PREIPH_BASE + IOPORT_BUS_OFFSET)

/* GPIOA Port mode base address*/
#define GPIOA_MODE_OFFSET    (0x00000000UL)
#define IOPORT_MODE_GPIOA_R  (*(volatile unsigned int *))(IOPORT_BUS_BASE + GPIOA_MODE_OFFSET)

/* GPIOA Port ODR configuration*/
#define GPIOA_ODR_OFFSET     (0x14UL)
#define IOPORT_ODR_GPIOA_R   (*(volatile unsigned int *))(IOPORT_BUS_BASE + GPIOA_ODR_OFFSET)
