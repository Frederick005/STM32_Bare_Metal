/* For that we need the to get the required Base addresses
 * In this case:
 * Peripheral Base
 * From Peripheral base, the AHB base and the IOPORT base
 */

#include <stdint.h>
#define PERIPHERAL_BASE (0x40000000UL)

/*
 * Defining the base address of buses
 */

#define AHB_OFFSET      (0x00020000UL)
#define AHB_PERIPH_BASE (PERIPHERAL_BASE + AHB_OFFSET)

#define IOPORT_OFFSET   (0x10000000UL)
#define IOPORT_BASE     (PERIPHERAL_BASE + IOPORT_OFFSET)

/*
 * Getting the RCC BASE
 */

#define RCC_OFFSET      (0x00001000UL)
#define RCC_BASE        (AHB_PERIPH_BASE + RCC_OFFSET)

/*
 * Getting GPIOA BASE
 */

#define GPIOA_OFFSET    (0x00000000UL)
#define GPIOA_BASE       (IOPORT_BASE + GPIOA_OFFSET)

/*
 * Getting USER PIN 4
 */
