void exti13_callback(void)
{

}

void EXTI15_10_IRQHandler(void)
{
	if((EXTI->PR & EXTI_LINE_13) != 0)
		{
			// Clear the pr flag
			EXTI->PR |= EXTI_LINE_13;

			// execute this funcion
			exti13_callback();
		}
}

