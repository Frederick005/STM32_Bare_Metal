#include "stdio.h"
#include "stm32f4xx.h"
#include "stdint.h"
#include "uart.h"

int main()
{
	uart_rx_init();

	RCC->AHB1ENR |=(1U<<0);
	GPIOA->MODER = (GPIOA->MODER & ~(3U<<10))|(1U<<10);

	while (1)
	{
		if ((USART2->SR & (1U<<5))!= 0)
		{
			if(USART2->DR == 'a')
			{
				GPIOA->ODR |= (1U<<5);
			}
		}
		else
		{
			GPIOA->ODR &= ~(1U<<5);
		}
	}

}



