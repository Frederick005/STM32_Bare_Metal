#include "stdio.h"
#include "stm32f4xx.h"
#include "stdint.h"
#include "uart.h"

char key;
int main()
{
	uart_rx_init();

	RCC->AHB1ENR |=(1U<<0);
	GPIOA->MODER = (GPIOA->MODER & ~(3U<<10))|(1U<<10);

	while (1)
	{
		key = uart_read();
		if (key=='1')
		{
				GPIOA->ODR |= (1U<<5);
		}
		else
		{
			GPIOA->ODR &= ~(1U<<5);
		}
	}
}



