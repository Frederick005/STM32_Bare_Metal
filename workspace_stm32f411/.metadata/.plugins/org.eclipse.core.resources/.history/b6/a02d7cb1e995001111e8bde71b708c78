#include "stm32f4xx.h"
#include "stdint.h"

#define PERIPH_CLK  16000000
#define BAUDRATE    115200

static void set_baud_rate(USART_TypeDef * USARTx, periph_clk, baudrate);
static uint16_t calculate_baud_rate(periph_clk, baudrate);

void uart_write(int ch);
void uart_init();


int main()
{
	uart_init();

	while (1)
	{
		uart_write('y');
	}

}

void uart_init()
{
	/*What all we need to do*/

	// Uart2 is the one that is connected via the stlink to the pc
	// It required pins pa2 and pa3. hence giveclock to gpioa
	RCC->AHB1ENR |= (1U<<0);

	// Now we need to see which bus has USART" connection
	// APB1 has Usart2. so we need to provide clock to it
	RCC->APB1ENR |= (1U<<17);

	//Set the mode of the GPIOA pin 2 and 3
	//For USART TX
	GPIOA->MODER = (GPIOA->MODER & (3U<<4))|(1U<<5);

	//For USART RX
	/*Insert code here*/

	// Set up the alternate function which was af07 which is "111"
	// each pin uses 4 bits and are number afrl0....afrl7
	//i.e All pin 0s use afrl0 and so on.
	// For pins beyond 7, the afrh registers need to be accessed.

	GPIOA->AFR[0] &= ~(15U<<8);
	GPIOA->AFR[0] |= ((1U<<8)|(1U<<9)|(1U<<10));

	// Enabling the usart direction i.e. tx using the control registers
	USART2->CR1 = (1U<<3);

	// Enabling the USART
	USART2->CR1 = (1U<<13);

	//setting the baudrate for the usart
	set_baud_rate (USART2, PERIPH_CLK, BAUDRATE);
}

void uart_write(int ch)
{
	while((USART2->SR & (1U<<7))==0){}

	//Filling values in the data register.
	USART2->DR = (ch & 0xFF);
}

static void set_baud_rate(USART_TypeDef * USARTx, uint32_t periph_clk, uint32_t baudrate)
{
	USARTx->BRR = calculate_baud_rate(periph_clk, baudrate);
}

static uint16_t calculate_baud_rate(uint32_t periph_clk, uint32_t baudrate)
{
	return ((periph_clk + (baudrate / 2U))/baudrate);
}
